<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Force HTTPS on Hostinger for all live traffic (excluding local test hosts)
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP_HOST} !^localhost
  RewriteCond %{HTTP_HOST} !^127\.0\.0\.1
  RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Server-side 301 SEO redirects for alias/typo routes
  RewriteRule ^itenary/(.*)$ /itinerary/$1 [R=301,L]
  RewriteRule ^(itinerary|itenary|itineraries)/?$ /domestic [R=301,L]
  RewriteRule ^thankyou/?$ /thank-you [R=301,L]

  # 3. Serve physical files and directories directly (e.g., sitemap.xml, robots.txt, assets, api jsons)
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # 4. SPA Fallback: Route all other requests to index.html
  RewriteRule . /index.html [L]
</IfModule>

# Prevent caching of index.html so Google Tag & app updates propagate instantly on Hostinger
<FilesMatch "^(index\.html|robots\.txt|sitemap\.xml)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
    Header set Expires 0
  </IfModule>
</FilesMatch>

# Security Headers (Configured to allow Google Tag Manager & GA4 without CSP conflicts)
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Browser Caching for Hashed Production Assets on Hostinger
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# Gzip / Deflate Compression on Hostinger
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css application/javascript application/json image/svg+xml
</IfModule>
